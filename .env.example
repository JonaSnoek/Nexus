# =============================================================================
# NEXUS Configuration
# =============================================================================
# Copy this file to .env and edit as needed:
#   cp .env.example .env

# --- Application ---
NEXUS_PORT=3000
NEXUS_SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING
NEXUS_LLM_MODEL=qwen3:8b

# --- Database ---
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://nexus:CHANGE_ME@postgres:5432/nexus

# --- Ollama ---
OLLAMA_URL=http://ollama:11434

# --- OIDC / SSO (optional, bootstrap-only) ---
# Values below are imported into the database on first start.
# After that, configure via the Admin → Settings panel.
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost/auth/callback
OIDC_GROUP_ADMINS=admins
OIDC_GROUP_USERS=users

# --- Admin Setup (first install only) ---
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_EMAIL=admin@nexus.local

# --- Image Generation ---
# Provider: "none" (disabled) or "openai_compatible" (e.g. DALL-E, self-hosted OpenAI-compatible endpoints).
# These are bootstrap-only defaults; configure at runtime via Admin → Settings → Bildgenerierung.
IMAGE_PROVIDER=none
IMAGE_MODEL=dall-e-3
IMAGE_API_URL=https://api.openai.com/v1
IMAGE_API_KEY=
MEDIA_DIR=/data/media

# --- Backup ---
BACKUP_DIR=./backups
